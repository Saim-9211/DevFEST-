# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (newer projects) or the legacy anon key. Either name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by `npm run seed:users` to create demo accounts. NEVER expose or commit this.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: password for all demo accounts created by seed:users
# DEMO_PASSWORD=BulkBasket#2026
