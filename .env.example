# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (newer projects) or the legacy anon key. Either name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to confirm payments from the gateway webhook and by `npm run seed:users`.
# NEVER expose or commit this.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for /api/payments/webhook (required in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# Optional: password for all demo accounts created by seed:users
# DEMO_PASSWORD=Collective#2026
